msgid "Stable Diffusion (Local)"
msgstr "Stable Diffusion (локально)"

#: src/constants.py:35
msgid ""
"Run Stable Diffusion locally using stable-diffusion.cpp, with hardware "
"acceleration support (CUDA, Vulkan, ROCm)."
msgstr ""
"Запускайте Stable Diffusion локально с помощью stable-diffusion.cpp, с "
"поддержкой аппаратного ускорения (CUDA, Vulkan, ROCm)."

