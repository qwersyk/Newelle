#: src/constants.py:406
msgid "Outcrawl"
msgstr "Outcrawl"

#: src/constants.py:407
msgid "Outcrawl web search API"
msgstr "API веб-поиска Outcrawl"

#: src/constants.py:416
msgid "OpenAI Compatible API"
msgstr "API, совместимый с OpenAI"

#: src/constants.py:417
msgid "Expose the current LLM as an OpenAI-compatible API server"
msgstr ""
"Предоставляет текущую языковую модель через API-сервер, совместимый с "
"OpenAI."

#: src/constants.py:422
msgid "Newelle GUI API"
msgstr "API графического интерфейса Newelle"

#: src/constants.py:423
msgid ""
"Full REST API for building a WebUI, exposing chats, messages, tools, "
"settings and more"
msgstr ""
"Полноценный REST API для создания веб-интерфейса с доступом к чатам, "
"сообщениям, инструментам, настройкам и многому другому."

#: src/constants.py:428
msgid "Telegram Bot"
msgstr "Бот Telegram"

#: src/constants.py:429
msgid ""
"Use Newelle as a Telegram bot with message streaming, voice transcription, "
"tools and more"
msgstr ""
"Используйте Newelle как бота Telegram: с потоковой передачей сообщений, "
"расшифровкой голосовых сообщений, инструментами и многим другим."

#: src/constants.py:434
msgid "MCP Server"
msgstr "Сервер MCP"

#: src/constants.py:435
msgid ""
"Expose Newelle tools to third-party applications over the Model Context "
"Protocol"
msgstr ""
"Предоставляет инструменты Newelle сторонним приложениям через протокол "
"контекста модели (MCP)."

#: src/constants.py:652
msgid "Read AGENT.md file at each execution"
msgstr "Читать файл AGENT.md при каждом запуске"

#: src/constants.py:653
msgid ""
"Read AGENT.md (Generally made to give indications to agents about the "
"project) file in the current directory at each execution"
msgstr ""
"При каждом запуске читать файл AGENT.md в текущем каталоге (обычно в нём "
"содержатся указания для агентов по работе с проектом)."

#: src/constants.py:661
msgid "Helpful assistant"
msgstr "Полезный помощник"

#: src/constants.py:662
msgid ""
"General purpose prompt to enhance the LLM answers and give more context"
msgstr ""
"Подсказка общего назначения для улучшения ответов LLM и предоставления "
"большего контекста"

#: src/constants.py:670
msgid "Environment information"
msgstr "Информация об окружении"

#: src/constants.py:671
msgid "Add information and instructions about the current environment"
msgstr "Добавляет сведения и инструкции о текущем окружении."

#: src/constants.py:679
msgid "Basic functionality"
msgstr "Базовая функциональность"

#: src/constants.py:680
msgid "Showing tables and code (*can work without it)"
msgstr "Показывать таблицы и код (*может работать без этого)"

#: src/constants.py:688
msgid "Source attribution"
msgstr "Указание источников"

#: src/constants.py:689
msgid ""
"Cite contextual sources inline and list cited sources at the end of the "
"response"
msgstr ""
"Приводит ссылки на источники контекста в тексте и перечисляет цитируемые "
"источники в конце ответа."

#: src/constants.py:697
msgid "Graphs access"
msgstr "Доступ к графикам"

#: src/constants.py:698
msgid "Can the program display graphs"
msgstr "Может ли программа отображать графики"

