#: src/handlers/image_generator/stablediffusion_cpp_handler.py:733
msgid "LoRA Folder"
msgstr "LoRA-ის საქაღალდე"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:734
msgid "Directory containing LoRA weights (.safetensors, .ckpt)"
msgstr "საქაღალდე, რომელიც შეიცავს LoRA-ის წონებს (.safetensors, .ckpt)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:750
