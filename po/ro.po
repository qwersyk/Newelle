#: src/workspaces.py:133
msgid "The desktop is busy. Try again."
msgstr "Desktopul este ocupat. Încercați din nou."

#: src/workspaces.py:145
msgid "Switch to this workspace before changing its folder."
msgstr "Comutați la acest spațiu de lucru înainte de a-i schimba dosarul."

#: src/workspaces.py:153
msgid "A name and an existing directory are required"
msgstr "Sunt necesare un nume și un director existent"

#: src/workspaces.py:158
msgid "Mode not found"
msgstr "Modul nu a fost găsit"

#: src/workspaces.py:193
msgid "A folder path is required."
msgstr "Este necesară o cale către dosar."

#: src/workspaces.py:198
#, python-brace-format
msgid "Directory not found: {path}"
msgstr "Directorul nu a fost găsit: {path}"

#: src/workspaces.py:229
msgid "Switch to this chat's workspace before continuing."
msgstr "Comutați la spațiul de lucru al acestui chat înainte de a continua."

#: src/workspaces.py:231
#, python-brace-format
msgid "Workspace folder: {path}"
msgstr "Dosarul spațiului de lucru: {path}"

#: src/workspaces.py:359
msgid "Workspace directory is unavailable. Using your home directory."
msgstr ""
"Directorul spațiului de lucru nu este disponibil. Se va folosi dosarul "
"personal."

#: src/workspaces.py:379
msgid "Workspace is switching. Please try again."
msgstr "Spațiul de lucru se schimbă. Încercați din nou."

#: src/workspaces.py:451 src/workspaces.py:463
msgid "A workspace name is required."
msgstr "Este necesar un nume pentru spațiul de lucru."

#: src/workspaces.py:475
msgid "The Default workspace cannot be deleted."
msgstr "Spațiul de lucru implicit nu poate fi șters."

#: src/workspaces.py:477
msgid "Switch workspaces before deleting the active workspace."
msgstr "Comutați la alt spațiu de lucru înainte de a-l șterge pe cel activ."

#: src/workspaces.py:524 src/workspaces.py:531
msgid "Finish or stop active work before changing workspaces."
msgstr ""
"Finalizați sau opriți activitatea în curs înainte de a schimba spațiile de "
"lucru."

#: src/workspaces.py:529
msgid "Wait for the workspace window to finish loading."
msgstr "Așteptați ca fereastra spațiului de lucru să se încarce complet."

#: src/workspaces.py:533
msgid "Close this workspace's window before deleting it."
msgstr "Închideți fereastra acestui spațiu de lucru înainte de a-l șterge."

