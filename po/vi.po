#: src/handlers/image_generator/stablediffusion_cpp_handler.py:734
msgid "Directory containing LoRA weights (.safetensors, .ckpt)"
msgstr "Thư mục chứa trọng số LoRA (.safetensors, .ckpt)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:750
msgid "Enable Image Editing"
msgstr "Bật chỉnh sửa ảnh"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:751
msgid ""
"Enable the edit_image tool. Requires a downloaded image-edit variant from "
"the Model Library (Qwen Image Edit, Qwen Image 2.1 Edit, LongCat Edit, Boogu"
" Edit, LLaDA Edit, or Kontext)."
msgstr ""
"Bật công cụ edit_image. Cần tải xuống một biến thể chỉnh sửa ảnh từ Thư viện"
" mô hình (Qwen Image Edit, Qwen Image 2.1 Edit, LongCat Edit, Boogu Edit, "
"LLaDA Edit hoặc Kontext)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:761
msgid "Image Editing Settings"
msgstr "Cài đặt chỉnh sửa ảnh"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:762
msgid ""
"Configure the image-edit model, its text encoders and editing-specific "
"overrides."
msgstr ""
"Cấu hình mô hình chỉnh sửa ảnh, bộ mã hóa văn bản và các tùy chọn ghi đè "
"dành riêng cho việc chỉnh sửa."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:766
msgid "Edit Model"
msgstr "Mô hình chỉnh sửa"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:767
msgid ""
"Stable Diffusion model to use for image editing. Pick a downloaded image-"
"edit variant or a custom file."
msgstr ""
"Mô hình Stable Diffusion dùng để chỉnh sửa ảnh. Chọn một biến thể chỉnh sửa "
"ảnh đã tải xuống hoặc một tệp tùy chỉnh."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:775
msgid "Edit VAE"
msgstr "VAE chỉnh sửa"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:776
msgid ""
"Path to the VAE used by the image-edit model (--vae). Leave empty to use the"
" model default or the variant manifest."
msgstr ""
"Đường dẫn đến VAE được mô hình chỉnh sửa ảnh sử dụng (--vae). Để trống để "
"dùng mặc định của mô hình hoặc tệp kê khai biến thể."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:782
msgid "Edit LLM"
msgstr "LLM chỉnh sửa"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:783
msgid "Path to the LLM text encoder (--llm) used by the image-edit model."
msgstr ""
"Đường dẫn đến bộ mã hóa văn bản LLM (--llm) được mô hình chỉnh sửa ảnh sử "
"dụng."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:789
msgid "Edit LLM Vision Projector"
msgstr "Bộ chiếu hình ảnh LLM chỉnh sửa"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:790
msgid ""
"Path to the vision projector file (--llm_vision) used by Qwen Image Edit "
"2509, Qwen Image 2.1 Edit, LongCat Edit and Boogu Edit."
msgstr ""
"Đường dẫn đến tệp bộ chiếu hình ảnh (--llm_vision) được Qwen Image Edit "
"2509, Qwen Image 2.1 Edit, LongCat Edit và Boogu Edit sử dụng."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:796
msgid "Edit: Qwen Image Zero Cond T (2511)"
msgstr "Chỉnh sửa: Qwen Image Zero Cond T (2511)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:797
msgid ""
"Enable zero_cond_t for Qwen Image Edit (--qwen-image-zero-cond-t). Required "
"for the 2511 variant for good results."
msgstr ""
"Bật zero_cond_t cho Qwen Image Edit (--qwen-image-zero-cond-t). Cần thiết để"
" biến thể 2511 cho kết quả tốt."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:802
msgid "Edit Extra CLI Arguments"
msgstr "Đối số CLI bổ sung cho chỉnh sửa"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:803
msgid ""
"Additional command-line arguments passed verbatim to sd-cli for image "
"editing. One per line."
msgstr ""
"Các đối số dòng lệnh bổ sung được truyền nguyên văn cho sd-cli để chỉnh sửa "
"ảnh. Mỗi dòng một đối số."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:815
msgid ""
"Override VAE, LLM and text encoder paths and tune low-VRAM / model-specific "
"CLI flags."
msgstr ""
"Ghi đè đường dẫn VAE, LLM và bộ mã hóa văn bản; tinh chỉnh cờ CLI cho VRAM "
"thấp hoặc theo từng mô hình."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:819
msgid "VAE"
msgstr "VAE"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:820
msgid ""
"Path to standalone VAE model (overrides --vae). Leave empty to use the model"
" default or the variant manifest."
msgstr ""
"Đường dẫn đến mô hình VAE độc lập (ghi đè --vae). Để trống để dùng mặc định "
"của mô hình hoặc tệp kê khai biến thể."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:826
msgid "LLM (Qwen / Mistral / Gemma / Ovis)"
msgstr "LLM (Qwen / Mistral / Gemma / Ovis)"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:827
msgid ""
"Path to the LLM text encoder (--llm) used by Qwen Image, FLUX.2, Z-Image, "
"LTX-2, Ovis, Anima, Krea2, ERNIE, LongCat, Boogu, LLaDA."
msgstr ""
"Đường dẫn đến bộ mã hóa văn bản LLM (--llm) được Qwen Image, FLUX.2, "
"Z-Image, LTX-2, Ovis, Anima, Krea2, ERNIE, LongCat, Boogu, LLaDA sử dụng."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:833
msgid "CLIP-L"
msgstr "CLIP-L"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:834
msgid ""
"Path to the CLIP-L text encoder (--clip_l) used by SD3.5, FLUX.1, Kontext."
msgstr ""
"Đường dẫn đến bộ mã hóa văn bản CLIP-L (--clip_l) được SD3.5, FLUX.1, "
"Kontext sử dụng."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:840
msgid "CLIP-G"
msgstr "CLIP-G"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:841
msgid "Path to the CLIP-G text encoder (--clip_g) used by SD3.5."
msgstr "Đường dẫn đến bộ mã hóa văn bản CLIP-G (--clip_g) được SD3.5 sử dụng."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:847
msgid "T5XXL"
msgstr "T5XXL"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:848
msgid ""
"Path to the T5XXL text encoder (--t5xxl) used by FLUX.1, Kontext, Chroma, "
"SD3.5, MiniT2I."
msgstr ""
"Đường dẫn đến bộ mã hóa văn bản T5XXL (--t5xxl) được FLUX.1, Kontext, "
"Chroma, SD3.5, MiniT2I sử dụng."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:854
msgid "Tokenizer JSON"
msgstr "Tokenizer JSON"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:855
msgid ""
"Path to an external Hugging Face tokenizer.json (--tokenizer) used by LLaDA-"
"Image and similar models."
msgstr ""
"Đường dẫn đến tokenizer.json bên ngoài của Hugging Face (--tokenizer) được "
"LLaDA-Image và các mô hình tương tự sử dụng."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:861
msgid "Video VAE"
msgstr "VAE video"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:862
msgid "Path to the video VAE (used as --vae for LTX-2)."
msgstr "Đường dẫn đến VAE video (được dùng làm --vae cho LTX-2)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:868
msgid "Audio VAE"
msgstr "VAE âm thanh"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:869
msgid "Path to the audio VAE (--audio-vae) used by LTX-2."
msgstr "Đường dẫn đến VAE âm thanh (--audio-vae) được LTX-2 sử dụng."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:875
msgid "Embeddings Connectors"
msgstr "Bộ kết nối embedding"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:876
msgid ""
"Path to the embeddings connectors safetensors (--embeddings-connectors) used"
" by LTX-2."
msgstr ""
"Đường dẫn đến tệp safetensors của bộ kết nối embedding (--embeddings-"
"connectors) được LTX-2 sử dụng."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:882
msgid "Offload to CPU"
msgstr "Chuyển tải sang CPU"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:883
msgid ""
"Place weights in RAM and load them into VRAM on demand (--offload-to-cpu)."
msgstr ""
"Đặt trọng số trong RAM và tải chúng vào VRAM khi cần (--offload-to-cpu)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:888
msgid "Diffusion Flash Attention"
msgstr "Flash Attention cho khuếch tán"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:889
msgid "Use flash attention in the diffusion model (--diffusion-fa)."
msgstr "Dùng flash attention trong mô hình khuếch tán (--diffusion-fa)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:894
msgid "VAE Tiling"
msgstr "Chia ô VAE"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:895
msgid "Process VAE in tiles to reduce memory usage (--vae-tiling)."
msgstr "Xử lý VAE theo từng ô để giảm mức sử dụng bộ nhớ (--vae-tiling)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:900
msgid "Keep CLIP on CPU"
msgstr "Giữ CLIP trên CPU"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:901
msgid "Keep CLIP text encoders in CPU memory (--clip-on-cpu)."
msgstr "Giữ các bộ mã hóa văn bản CLIP trong bộ nhớ CPU (--clip-on-cpu)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:906
msgid "Keep VAE on CPU"
msgstr "Giữ VAE trên CPU"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:907
msgid "Keep VAE in CPU memory (--vae-on-cpu)."
msgstr "Giữ VAE trong bộ nhớ CPU (--vae-on-cpu)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:912
msgid "Chroma: Disable DiT Mask"
msgstr "Chroma: Tắt mặt nạ DiT"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:913
msgid "Disable DiT mask for Chroma (--chroma-disable-dit-mask)."
msgstr "Tắt mặt nạ DiT cho Chroma (--chroma-disable-dit-mask)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:918
msgid "Chroma: Enable T5 Mask"
msgstr "Chroma: Bật mặt nạ T5"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:919
msgid "Enable T5 mask for Chroma (--chroma-enable-t5-mask)."
msgstr "Bật mặt nạ T5 cho Chroma (--chroma-enable-t5-mask)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:924
msgid "Qwen Image: Zero Cond T"
msgstr "Qwen Image: Zero Cond T"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:925
msgid "Enable zero_cond_t for Qwen Image (--qwen-image-zero-cond-t)."
msgstr "Bật zero_cond_t cho Qwen Image (--qwen-image-zero-cond-t)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:930
msgid "Flow Shift"
msgstr "Dịch chuyển Flow"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:931
msgid "Shift value for Flow models (e.g. 3 for Qwen Image). 0 = auto."
msgstr ""
"Giá trị dịch chuyển cho các mô hình Flow (ví dụ: 3 cho Qwen Image). 0 = tự "
"động."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:936
msgid "Prediction Type"
msgstr "Loại dự đoán"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:937
msgid "Override the model's prediction type (--prediction)."
msgstr "Ghi đè loại dự đoán của mô hình (--prediction)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:943
msgid "Weight Type"
msgstr "Loại trọng số"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:945
msgid ""
"Override the model weight type (--type). Model default uses the type stored "
"in the weight file."
msgstr ""
"Ghi đè loại trọng số của mô hình (--type). Mặc định của mô hình dùng loại "
"được lưu trong tệp trọng số."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:949
msgid "Model default"
msgstr "Mặc định của mô hình"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:970
msgid "Cache Mode"
msgstr "Chế độ bộ nhớ đệm"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:971
msgid "Caching method for faster inference (--cache-mode)."
msgstr "Phương thức lưu vào bộ nhớ đệm để suy luận nhanh hơn (--cache-mode)."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:977
msgid "RNG"
msgstr "RNG"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:978
msgid ""
"Random number generator backend (--rng). 'cuda' matches A1111, 'cpu' matches"
" ComfyUI."
msgstr ""
"Phần phụ trợ tạo số ngẫu nhiên (--rng). 'cuda' tương thích với A1111, 'cpu' "
"tương thích với ComfyUI."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:984
msgid "Extra CLI Arguments"
msgstr "Đối số CLI bổ sung"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:985
msgid ""
"Additional command-line arguments passed verbatim to sd-cli / sd-server. One"
" per line, e.g. '--vae-tile-size 64x64'."
msgstr ""
"Các đối số dòng lệnh bổ sung được truyền nguyên văn cho sd-cli / sd-server. "
"Mỗi dòng một đối số, ví dụ: '--vae-tile-size 64x64'."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:1601
#: src/handlers/tts/kokoro_handler.py:164
msgid "Finalizing model file"
msgstr "Đang hoàn tất tệp mô hình"

#: src/handlers/interfaces/api_handler.py:73
#: src/handlers/interfaces/gui_api_handler.py:33
msgid ""
"API key required to authenticate requests (leave empty to disable "
"authentication)"
msgstr "Cần có khóa API để xác thực yêu cầu (để trống để tắt xác thực)"

