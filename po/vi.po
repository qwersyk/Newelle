msgstr "Mô hình AI cần dùng"

#: src/handlers/llm/gemini_handler.py:103
msgid "Enable System Prompt"
msgstr "Bật lời nhắc hệ thống"

#: src/handlers/llm/gemini_handler.py:103
msgid ""
"Some models don't support system prompt (or developers instructions), "
"disable it if you get errors about it"
msgstr ""
"Một số mô hình không hỗ trợ lời nhắc hệ thống (hoặc chỉ dẫn của nhà phát "
"triển), hãy tắt tùy chọn này nếu bạn gặp lỗi liên quan"

#: src/handlers/llm/gemini_handler.py:107
msgid "Inject system prompt"
msgstr "Chèn lời nhắc hệ thống"

#: src/handlers/llm/gemini_handler.py:107
msgid ""
"Even if the model doesn't support system prompts, put the prompts on top of "
"the user message"
msgstr ""
"Ngay cả khi mô hình không hỗ trợ lời nhắc hệ thống, vẫn đặt các lời nhắc lên "
"đầu tin nhắn của người dùng"

#: src/handlers/llm/gemini_handler.py:109
msgid "Thinking Settings"
msgstr "Cài đặt suy nghĩ"

#: src/handlers/llm/gemini_handler.py:109
