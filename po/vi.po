msgstr "Hiển thị quá trình suy nghĩ, hãy tắt nếu mô hình của bạn không hỗ trợ"

#: src/handlers/llm/gemini_handler.py:111
msgid "Enable Thinking Budget"
msgstr "Bật ngân sách suy nghĩ"

#: src/handlers/llm/gemini_handler.py:111
msgid "If to enable thinking budget"
msgstr "Có bật ngân sách suy nghĩ hay không"

#: src/handlers/llm/gemini_handler.py:112
msgid "Thinking Budget"
msgstr "Ngân sách suy nghĩ"

#: src/handlers/llm/gemini_handler.py:112
msgid "How much time to spend thinking"
msgstr "Thời gian dành cho việc suy nghĩ"

#: src/handlers/llm/gemini_handler.py:116
msgid "Image Output"
msgstr "Đầu ra hình ảnh"

#: src/handlers/llm/gemini_handler.py:116
