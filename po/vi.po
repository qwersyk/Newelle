msgstr "Chọn nhà cung cấp dựa trên giá/thông lượng hoặc độ trễ"

#: src/handlers/llm/openrouter_handler.py:14
msgid "Price"
msgstr "Giá"

#: src/handlers/llm/openrouter_handler.py:14
msgid "Throughput"
msgstr "Thông lượng"

#: src/handlers/llm/openrouter_handler.py:14
msgid "Latency"
msgstr "Độ trễ"

#: src/handlers/llm/openrouter_handler.py:15
msgid "Providers Order"
msgstr "Thứ tự nhà cung cấp"

#: src/handlers/llm/openrouter_handler.py:15
msgid ""
"Add order of providers to use, names separated by a comma.\n"
"Empty to not specify"
msgstr ""
"Nhập thứ tự các nhà cung cấp cần dùng, tên cách nhau bằng dấu phẩy.\n"
"Để trống nếu không chỉ định"

#: src/handlers/llm/openrouter_handler.py:16
msgid "Allow Fallbacks"
msgstr "Cho phép dự phòng"

#: src/handlers/llm/openrouter_handler.py:16
msgid "Allow fallbacks to other providers"
msgstr "Cho phép chuyển dự phòng sang nhà cung cấp khác"

#: src/handlers/rag/rag_handler.py:104
msgid "Index your documents"
msgstr "Lập chỉ mục tài liệu"

#: src/handlers/rag/rag_handler.py:105
msgid ""
"Index all the documents in your document folder. You have to run this "
"operation every time you edit/create a document, change document analyzer or "
"change embedding model"
msgstr ""
"Lập chỉ mục tất cả tài liệu trong thư mục tài liệu của bạn. Bạn phải chạy "
"thao tác này mỗi khi sửa/tạo tài liệu, đổi trình phân tích tài liệu hoặc đổi "
"mô hình embedding"

