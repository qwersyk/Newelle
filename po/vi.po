msgstr "Bật đầu ra hình ảnh, chỉ được hỗ trợ bởi gemini-2.0-flash-exp"

#: src/handlers/llm/gemini_handler.py:125
msgid "Enable safety settings"
msgstr "Bật cài đặt an toàn"

#: src/handlers/llm/gemini_handler.py:126
