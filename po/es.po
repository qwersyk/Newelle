"usuario."

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:703
msgid "Negative Prompt Template"
msgstr "Plantilla del prompt negativo"

#: src/handlers/image_generator/stablediffusion_cpp_handler.py:704
