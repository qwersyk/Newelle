#: src/constants.py:338 src/ui/settings.py:196 src/ui/widgets/chat_tab.py:731
#: src/ui/widgets/memory_mini_app.py:45
msgid "Long Term Memory"
msgstr "Довготривала пам'ять"

#: src/constants.py:339
msgid ""
"Keeps a short summary of the user plus facts and past conversations, "
"recalled with hybrid semantic and keyword search. Old memories fade over "
"time. Uses the document analyzer and the embedding model."
msgstr ""
"Зберігає стислий опис користувача, факти та минулі розмови й відтворює їх за"
" допомогою гібридного семантичного пошуку та пошуку за ключовими словами. З "
"часом старі спогади згасають. Використовує аналізатор документів і модель "
"векторних представлень."

#: src/constants.py:344 src/handlers/memory/user_summary_handler.py:29
#: src/ui/widgets/memory_mini_app.py:63
msgid "User Summary"
msgstr "Підсумок користувача"

#: src/constants.py:345
msgid "Generate a summary of the user's conversation"
msgstr "Створити підсумок розмови користувача"

#: src/constants.py:350
msgid "Agentic Memory"
msgstr "Агентна пам'ять"

#: src/constants.py:351
msgid ""
"Long term memory using Agentic Memory. Stores conversations in a vector "
"store. Uses semantic search to retrieve memories."
msgstr ""
"Довготривала пам'ять на основі агентної пам'яті. Зберігає розмови у "
"векторному сховищі. Для пошуку спогадів використовує семантичний пошук."

#: src/constants.py:356
msgid "Semantic Memory"
msgstr "Семантична пам'ять"

#: src/constants.py:357
msgid ""
"Long term memory using LlamaIndex. Stores conversations in a vector store. "
"Uses semantic search to retrieve memories."
msgstr ""
"Довготривала пам'ять на основі LlamaIndex. Зберігає розмови у векторному "
"сховищі. Для пошуку спогадів використовує семантичний пошук."

#: src/constants.py:365
msgid "Document reader"
msgstr "Читач документів"

#: src/constants.py:366
msgid ""
"Classic RAG approach - chunk documents and embed them, then compare them to "
"the query and return the most relevant documents"
msgstr ""
"Класичний підхід RAG – розбиття документів на фрагменти та їх вбудовування, "
"потім порівняння з запитом та повернення найбільш релевантних документів"

#: src/constants.py:374
msgid "SearXNG"
msgstr "SearXNG"

#: src/constants.py:375
